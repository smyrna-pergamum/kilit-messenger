<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The embedded Tor needs the network; nothing else in Kilit opens a
         connection, and everything goes through Tor. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The camera plugin asks for the microphone for video; Kilit takes
         stills only (enableAudio: false), so it is taken out again. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>

    <application
        android:label="Kilit"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- .klt files opened from a file manager or a chat. Android has no
                 reliable way to match an extension on content:// URIs, so
                 Kilit offers itself for opaque binary files and checks the
                 KLT1 magic before doing anything with them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:mimeType="application/octet-stream"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:mimeType="application/x-kilit"/>
            </intent-filter>
            <!-- kilit://add?id=... links: someone's Kilit ID, from a chat or a
                 web page. They only fill in the add-contact sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="kilit" android:host="add"/>
            </intent-filter>
            <!-- "Share" to Kilit: a .klt file, or a KLT1: message from WhatsApp -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Flutter's default PROCESS_TEXT query is left out on purpose: it would
         offer selected text to other installed apps. -->
</manifest>
